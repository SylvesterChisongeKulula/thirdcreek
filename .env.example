# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit real secrets.

# SQLite/libSQL database location. Defaults to file:.data/thirdcreek.db if unset.
# DATABASE_URL=file:.data/thirdcreek.db

# Secret used to sign/encrypt admin session cookies. Required in production;
# falls back to an insecure dev-only value otherwise.
SESSION_PASSWORD=

# Dev-only login passwords used by `npm run db:seed` (and by the auto-seed
# plugin below). Leave unset to fall back to the built-in dev defaults
# (owner-dev-password / staff-dev-password).
OWNER_DEV_PASSWORD=
STAFF_DEV_PASSWORD=

# Auto-seeds the database on boot if it's empty. Set to true only on staging —
# never set this in production.
SEED_ON_BOOT=false
